cabal-version: 3.0
name: runtime-bench
version: 0.1.0.0
synopsis: Runtime performance benchmarks for acolyte

executable runtime-bench
  main-is: Main.hs
  default-language: GHC2024
  default-extensions:
    DataKinds
    OverloadedStrings
    TypeApplications
    ScopedTypeVariables
    FlexibleInstances
    MultiParamTypeClasses
    StrictData
  ghc-options: -O2 -Wall -Wno-orphans -rtsopts
  build-depends:
      base >= 4.20 && < 5
    , acolyte-core
    , acolyte-server
    , spire
    , spire-grpc
    , spire-protobuf
    , http-core
    , tasty-bench >= 0.3 && < 0.5
    , case-insensitive >= 1.2 && < 1.3
    , bytestring >= 0.11 && < 0.13
    , text >= 2.0 && < 2.2
    , http-types >= 0.12 && < 0.13
    , deepseq >= 1.4 && < 1.6
    , proto3-suite >= 0.9 && < 1.0
    , proto3-wire >= 1.2 && < 1.5
