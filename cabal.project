packages:
  acolyte-core
  spire
  http-core
  spire-http
  spire-wai
  acolyte-server
  acolyte-client
  acolyte-openapi
  acolyte-test
  acolyte
  spire-server
  spire-grpc
  spire-websocket
  acolyte-grpc
  acolyte-codegen
  examples/hello-world
  examples/minimal
  examples/realworld
  examples/realworld-combined
  examples/crud
  examples/auth
  examples/custom-extractors
  examples/grpc-demo
  examples/chat
  examples/versioned-api
  examples/negotiate
  examples/streaming
  bench/compile-time
  bench/runtime
  spire-protobuf

-- Enable all test suites by default (including hedgehog property tests)
tests: True

-- Use GHC 9.10.3
-- with-compiler: ghc-9.10.3

-- Production optimization: -O2 for all library code
package acolyte-core
  ghc-options: -O2
package spire
  ghc-options: -O2
package http-core
  ghc-options: -O2
package spire-http
  ghc-options: -O2
package spire-wai
  ghc-options: -O2
package spire-server
  ghc-options: -O2
package spire-grpc
  ghc-options: -O2
package spire-websocket
  ghc-options: -O2
package acolyte-server
  ghc-options: -O2
package acolyte-client
  ghc-options: -O2
package acolyte-openapi
  ghc-options: -O2
package acolyte-grpc
  ghc-options: -O2
package acolyte-codegen
  ghc-options: -O2
package acolyte-test
  ghc-options: -O2
package acolyte
  ghc-options: -O2
