cabal-version:   3.0
name:            minimal
version:         0.1.0.0
synopsis:        Minimal acolyte example
build-type:      Simple

executable minimal
  main-is: Main.hs
  hs-source-dirs: .
  default-language: GHC2021

  build-depends:
      base                       >= 4.20 && < 5
    , acolyte
    , bytestring                 >= 0.11 && < 0.13
    , text                       >= 2.0  && < 2.2
