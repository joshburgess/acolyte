cabal-version:   3.0
name:            versioned-api
version:         0.1.0.0
synopsis:        API versioning with compile-time backward compatibility
build-type:      Simple

executable versioned-api
  main-is: Main.hs
  hs-source-dirs: .
  default-language: GHC2024
  default-extensions:
    DataKinds
    TypeFamilies
    TypeOperators
    OverloadedStrings
    AllowAmbiguousTypes
    ScopedTypeVariables
    UndecidableInstances

  build-depends:
      base                       >= 4.20 && < 5
    , acolyte
    , bytestring                 >= 0.11 && < 0.13
    , text                       >= 2.0  && < 2.2
