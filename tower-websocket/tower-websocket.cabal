cabal-version:   3.0
name:            tower-websocket
version:         0.1.0.0
synopsis:        WebSocket session type runtime for acolyte
description:
  Linear session types for WebSocket protocols. The phantom-typed
  Session handle enforces send/recv ordering at compile time via
  GHC's LinearTypes — each operation consumes the current session
  and produces the next state, so misuse is a type error.

license:         BSD-3-Clause
license-file:    ../LICENSE
author:          Josh Burgess
maintainer:      Josh Burgess
homepage:        https://github.com/joshburgess/acolyte
bug-reports:     https://github.com/joshburgess/acolyte/issues
build-type:      Simple

library
  exposed-modules:
    Tower.WebSocket
    Tower.WebSocket.Session

  build-depends:
      base                    >= 4.20 && < 5
    , acolyte-core
    , tower
    , http-core
    , bytestring              >= 0.11 && < 0.13
    , text                    >= 2.0  && < 2.2
    , aeson                   >= 2.1  && < 2.3

  hs-source-dirs: src
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    StrictData

  ghc-options: -Wall -funbox-strict-fields

test-suite spec
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    StrictData

  ghc-options: -Wall -rtsopts "-with-rtsopts=-K1K"

  build-depends:
      base                    >= 4.20 && < 5
    , tower-websocket
    , acolyte-core
    , bytestring              >= 0.11 && < 0.13
    , text                    >= 2.0  && < 2.2
    , aeson                   >= 2.1  && < 2.3

test-suite properties
  type: exitcode-stdio-1.0
  main-is: Properties.hs
  hs-source-dirs: test
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    StrictData
  ghc-options: -Wall
  build-depends:
      base                    >= 4.20 && < 5
    , tower-websocket
    , acolyte-core
    , hedgehog                >= 1.4  && < 1.8
    , bytestring              >= 0.11 && < 0.13
    , text                    >= 2.0  && < 2.2
    , aeson                   >= 2.1  && < 2.3

source-repository head
  type:     git
  location: https://github.com/joshburgess/acolyte.git
